[node name="InfoAreas" type="Node2D" parent="Arcade" unique_id=1932251845]

[node name="Yt" parent="Arcade/InfoAreas" unique_id=249884853 instance=ExtResource("6_tefeu")]
position = Vector2(63, 125)
info_text = "I really like to document my journey in game dev. As a result I've made a youtube channel to show off and share my games and the process behidn them. My main style inspirations include Dani (pls come back), Sebastian Lague, Steven, and ThinMatrix, which are all classic channels that I've watched for a long time. I hope to become a better storyteller/editor along the way and make some entertaining content!"
info_name = "Youtube Channel!"
link = "https://youtube.com/@frankanator"

[node name="CollisionShape2D" parent="Arcade/InfoAreas/Yt" index="0" unique_id=1083559723]
position = Vector2(7, 0.75)
shape = SubResource("RectangleShape2D_fuf3a")

[node name="FarewellTmrw" parent="Arcade/InfoAreas" unique_id=167318133 instance=ExtResource("6_tefeu")]
position = Vector2(-55, 154)
info_text = "Farewell, Tomorrow! is my latest good game. It's a joint puzzle/narrative game with John Xu (@Yapples) and Kevin Wang. I contributed some art, all of the music/sfx, and did a lot of the game programming as well. It's my prettiest game to date, where I realized the power of lighting and good pixel art. This game was submitted and made for GMTK 2026!"
info_name = "Farewell Tomorrow"
link = "https://frankanator8.itch.io/farewell-tomorrow"

[node name="CollisionShape2D" parent="Arcade/InfoAreas/FarewellTmrw" index="0" unique_id=1083559723]
position = Vector2(0, -5)
shape = SubResource("RectangleShape2D_pibwh")

[node name="RotSq" parent="Arcade/InfoAreas" unique_id=886358357 instance=ExtResource("6_tefeu")]
position = Vector2(-87, 154)
info_text = "Rotation Squared is a simple, 2D physics-based puzzle game. It's the smallest game on this list, but I think it's really polished and really fun (and not to mention, at the time of writing it has by far the best video made for it as well). It's completely made by me as well, so that's cool - check it out if you want :D"
info_name = "Rotation Squared"
link = "https://frankanator8.itch.io/rotating-squared"

[node name="CollisionShape2D" parent="Arcade/InfoAreas/RotSq" index="0" unique_id=1083559723]
position = Vector2(0, -5)
shape = SubResource("RectangleShape2D_c6pm6")

[node name="Hexicast" parent="Arcade/InfoAreas" unique_id=2001530523 instance=ExtResource("6_tefeu")]
position = Vector2(-103, 185)
info_text = "Hexicast is my earliest \"good\" game, and was made in the summer between my sophomore and junior year of high school (so yes, BAI (before AI)). It's an isometric multiplayer game where you cast spells by drawing with your mouse. To this day, some of my best asset work is on that project and it was honestly a huge undertaking, allowing me to learn all about networking and optimization (since I ran it on a potato Mac) a lot more."
